# macOS
.DS_Store

# 本机私有配置（仅保留 *.example 模板）
local/local.sh
local/secrets
local/*.local

# Shell 编译缓存
*.zwc

# 编辑器临时文件
*.swp
*~
.idea/
.vscode/

# 日志
*.log

# shell 本机私有配置（整体符号链接 config/shell 时，真实 local.sh 会落入库内）
config/shell/local.sh
# starship 方案选择（starship_font 函数写入：nerd/plain/auto，本机私有）
config/shell/starship-font

# brew bundle 锁文件
Brewfile.lock.json

# git 身份私有文件
config/git/config.local
# git 代理私有文件（proxy_on/off 写入）
config/git/config.proxy

