# Brewfile - macOS 依赖（用 `brew bundle --file=Brewfile --no-lock` 安装）
# 每行附用途注释。brew "name" 表示安装该 formula。
brew "git"          # 版本控制
brew "zsh"          # 默认交互 shell
brew "tmux"         # 终端复用器
brew "neovim"       # 编辑器（配置需 0.12+）
brew "starship"     # 跨 shell 提示符
brew "ripgrep"      # rg：极速递归搜索（grep 替代）
brew "fd"           # fd：快速文件查找（find 替代）
brew "fzf"          # 模糊查找器（shell 集成 + nvim fzf-lua）
brew "zoxide"       # 智能目录跳转（cd 替代，提供 z）
brew "bat"          # cat 替代，带语法高亮
brew "eza"          # ls 替代，带图标/git 状态
brew "lazygit"      # 终端 git TUI
brew "git-delta"    # git diff 美化器
brew "jq"           # JSON 处理命令行
brew "gh"           # GitHub 官方 CLI
brew "yazi"         # 终端文件管理器
